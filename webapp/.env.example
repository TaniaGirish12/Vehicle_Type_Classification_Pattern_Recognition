# Copy this file to .env for local development (never commit .env)

# Flask secret key — any long random string
SECRET_KEY=change-me-to-a-long-random-string

# Set to "true" to run without model files (simulated predictions)
# Set to "false" to run live TF inference (requires model files in ./models/)
DEMO_MODE=true

# Enable Flask debug mode locally (never use in production)
FLASK_DEBUG=false

# Port (default 5000 locally; Render sets this automatically)
PORT=5000
