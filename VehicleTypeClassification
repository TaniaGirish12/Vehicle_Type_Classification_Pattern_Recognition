ion Matrices — All Models', fontsize=18, fontweight='bold')\nfor ax, (name, res) in zip(axes.flatten(), eval_results.items()):\n    plot_cm(res['cm'], CLASS_NAMES, name, ax)\nplt.tight_layout()\nplt.savefig(os.path.join(CONFIG['figures_dir'], 'fig6_confusion_matrices.png'), dpi=150, bbox_inches='tight')\nplt.show()\nprint(\"Confusion matrices saved.\")","metadata":{"_uuid":"4b0b50ff-44ad-4f31-8037-eb143ec1221d","_cell_guid":"c3813a2b-96aa-4b11-b54c-391113339ddf","trusted":true,"collapsed":false,"jupyter":{"outputs_hidden":false},"execution":{"iopub.status.busy":"2026-06-05T22:35:18.685452Z","iopub.execute_input":"2026-06-05T22:35:18.685818Z","iopub.status.idle":"2026-06-05T22:35:22.172153Z","shell.execute_reply.started":"2026-06-05T22:35:18.68579Z","shell.execute_reply":"2026-06-05T22:35:22.171538Z"}},"outputs":[{"output_type":"display_data","data":{"text/plain":"<Figure size 3600x3000 with 4 Axes>","image/png":"\n"},"metadata":{}},{"name":"stdout","text":"Confusion matrices saved.\n","output_type":"stream"}],"execution_count":27},{"cell_type":"code","source":"# ===========================================================================\n# SECTION 13: ROC CURVES\n# ===========================================================================\n\ndef plot_roc(y_true, y_proba, class_names, title, ax):\n    \"\"\"One-vs-rest ROC curves with macro average.\"\"\"\n    n = len(class_names)\n    y_bin = label_binarize(y_true, classes=list(range(n)))\n    fpr, tpr, roc_auc = {}, {}, {}\n    for i in range(n):\n        fpr[i], tpr[i], _ = roc_curve(y_bin[:, i], y_proba[:, i])\n        roc_auc[i] = auc(fpr[i], tpr[i])\n\n    all_fpr = np.unique(np.concatenate([fpr[i] for i in range(n)]))\n    mean_tpr = sum(np.interp(all_fpr, fpr[i], tpr[i]) for i in range(n)) / n\n    mac_auc = auc(all_fpr, mean_tpr)\n\n    colors = plt.cm.Set1(np.linspace(0, 0.9, n))\n    for i, c in enumerate(colors):\n        ax.plot(fpr[i], tpr[i], color=c, lw=1.5,\n                label=f'{class_names[i]} ({roc_auc[i]:.3f})')\n    ax.plot(all_fpr, mean_tpr, 'k--', lw=2.5, label=f'Macro ({mac_auc:.3f})')\n    ax.plot([0,1],[0,1],'gray',ls=':')\n    ax.set_xlim([0,1]); ax.set_ylim([0,1.02])\n    ax.set_xlabel('FPR', fontsize=10); ax.set_ylabel('TPR', fontsize=10)\n    ax.set_title(title, fontsize=12, fontweight='bold')\n    ax.legend(loc='lower right', fontsize=7); ax.grid(alpha=0.3)\n    return mac_auc\n\nfig, axes = plt.subplots(2, 2, figsize=(22, 18))\nfig.suptitle('ROC Curves (One-vs-Rest) — All Models', fontsize=18, fontweight='bold')\nmacro_aucs = {}\nfor ax, (name, res) in zip(axes.flatten(), eval_results.items()):\n    macro_aucs[name] = plot_roc(res['y_true'], res['y_proba'], CLASS_NAMES, name, ax)\nplt.tight_layout()\nplt.savefig(os.path.join(CONFIG['figures_dir'], 'fig7_roc_curves.png'), dpi=150, bbox_inches='tight')\nplt.show()\nprint(\"ROC curves saved.\")","metadata":{"_uuid":"8acbb45c-3936-4030-8445-fcc9cd785712","_cell_guid":"e6a337b3-f1d8-4dd0-b845-c824aba4020d","trusted":true,"collapsed":false,"jupyter":{"outputs_hidden":false},"execution":{"iopub.status.busy":"2026-06-05T22:35:34.401385Z","iopub.execute_input":"2026-06-05T22:35:34.401843Z","iopub.status.idle":"2026-06-05T22:35:36.943975Z","shell.execute_reply.started":"2026-06-05T22:35:34.401813Z","shell.execute_reply":"2026-06-05T22:35:36.94314Z"}},"outputs":[{"output_type":"display_data","data":{"text/plain":"<Figure size 3300x2700 with 4 Axes>","image/png":"\n"},"metadata":{}},{"name":"stdout","text":"ROC curves saved.\n","output_type":"stream"}],"execution_count":28},{"cell_type":"code","source":"# ===========================================================================\n# SECTION 14: GRAD-CAM VISUALIZATION\n# ===========================================================================\n\nclass GradCAM:\n    \"\"\"\n    Gradient-weighted Class Activation Mapping.\n    Reference: Selvaraju et al. (2017), ICCV.\n\n    Algorithm:\n    1. Forward pass → get conv feature maps + class predictions\n    2. Backprop gradient of target class score to last conv layer\n    3. Global-average-pool gradients → importance weights per channel\n    4. Weighted combination of feature maps → activation map\n    5. ReLU + normalize → heatmap in [0,1]\n    6. Resize to input image size + overlay\n    \"\"\"\n\n    def __init__(self, model, last_conv_layer_name):\n        self.model = model\n        self.conv_name = last_conv_layer_name\n        # Build sub-model: inputs → [conv_output, predictions]\n        self.grad_model = keras.Model(\n            inputs=model.inputs,\n            outputs=[model.get_layer(last_conv_layer_name).output, model.output]\n        )\n        print(f\"  Grad-CAM layer: {last_conv_layer_name}\")\n\n    def compute(self, img_batch, class_idx=None, eps=1e-8):\n        \"\"\"Compute heatmap for given image batch (1, H, W, C).\"\"\"\n        img_tensor = tf.convert_to_tensor(img_batch)\n        with tf.GradientTape() as tape:\n            conv_out, preds = self.grad_model(img_tensor, training=False)\n            pred_class = int(tf.argmax(preds[0]))\n            target_class = class_idx if class_idx is not None else pred_class\n            score = preds[:, target_class]\n\n        grads = tape.gradient(score, conv_out)\n        pooled_grads = tf.reduce_mean(grads, axis=(0, 1, 2))\n        heatmap = conv_out[0] @ pooled_grads[..., tf.newaxis]\n        heatmap = tf.squeeze(heatmap).numpy()\n        heatmap = np.maximum(heatmap, 0)\n        heatmap = (heatmap - heatmap.min()) / (heatmap.max() - heatmap.min() + eps)\n        return heatmap, pred_class, float(preds[0][target_class])\n\n    def overlay(self, heatmap, orig_img_uint8, alpha=0.4):\n        \"\"\"Overlay heatmap on original image (H,W,3 uint8).\"\"\"\n        h_resized = cv2.resize(heatmap, (orig_img_uint8.shape[1], orig_img_uint8.shape[0]))\n        h_uint8 = np.uint8(255 * h_resized)\n        h_color = cv2.applyColorMap(h_uint8, cv2.COLORMAP_JET)\n        h_color = cv2.cvtColor(h_color, cv2.COLOR_BGR2RGB)\n        overlay = cv2.addWeighted(orig_img_uint8, 1 - alpha, h_color, alpha, 0)\n        return overlay, h_color\n\n\n# ── Identify last conv layer per model ───────────────────────────────────────\nLAST_CONV_LAYERS = {\n    'Custom CNN':     'block4_conv2',\n    'MobileNetV2':    'block_16_project_BN',\n    'ResNet50':       'conv5_block3_out',\n    'EfficientNetB0': 'top_activation',\n}\n\ndef visualize_gradcam(model, model_name, test_paths, test_labels, n_per_class=1):\n    \"\"\"Generate Grad-CAM visualizations, one per class.\"\"\"\n    layer = LAST_CONV_LAYERS.get(model_name)\n    if not layer:\n        print(f\"No layer defined for {model_name}\")\n        return\n\n    try:\n        gcam = GradCAM(model, layer)\n    except Exception as e:\n        print(f\"GradCAM init failed for {model_name}: {e}\")\n        return\n\n    n_cls = len(CLASS_NAMES)\n    fig, axes = plt.subplots(n_cls, 3, figsize=(15, n_cls * 3.5))\n    fig.suptitle(f'Grad-CAM Visualizations — {model_name}', fontsize=16, fontweight='bold', y=1.01)\n\n    for r, (cls_idx, cls_name) in enumerate(zip(range(n_cls), CLASS_NAMES)):\n        candidates = [(p, l) for p, l in zip(test_paths, test_labels) if l == cls_idx]\n        found = False\n        for path, true_lbl in random.sample(candidates, min(20, len(candidates))):\n            try:\n                orig = np.array(Image.open(path).convert('RGB').resize(IMG_SIZE))\n                batch = orig.astype(np.float32)[np.newaxis] / 255.0\n                heatmap, pred_cls, prob = gcam.compute(batch, class_idx=cls_idx)\n                ov, hm_color = gcam.overlay(heatmap, orig)\n                correct = pred_cls == cls_idx\n                label = f\"True: {cls_name}\\nPred: {CLASS_NAMES[pred_cls]} ({prob*100:.1f}%) {'✓' if correct else '✗'}\"\n\n                axes[r, 0].imshow(orig); axes[r, 0].set_ylabel(label, fontsize=8, rotation=0, ha='right', va='center', labelpad=90); axes[r, 0].axis('off')\n                axes[r, 1].imshow(heatmap, cmap='jet', vmin=0, vmax=1); axes[r, 1].axis('off')\n                axes[r, 2].imshow(ov); axes[r, 2].axis('off')\n                found = True; break\n            except:\n                continue\n        if not found:\n            for c in range(3):\n                axes[r, c].text(0.5, 0.5, f'No sample for\\n{cls_name}', ha='center', va='center')\n                axes[r, c].axis('off')\n\n    axes[0, 0].set_title('Original', fontsize=12, fontweight='bold')\n    axes[0, 1].set_title('Heatmap', fontsize=12, fontweight='bold')\n    axes[0, 2].set_title('Overlay', fontsize=12, fontweight='bold')\n    plt.tight_layout()\n    safe = model_name.lower().replace(' ','_')\n    plt.savefig(os.path.join(CONFIG['figures_dir'], f'fig8_gradcam_{safe}.png'), dpi=150, bbox_inches='tight')\n    plt.show()\n    print(f\"Grad-CAM saved for {model_name}\")\n\n# Generate Grad-CAM for all models\nfor model_name, model in [('Custom CNN', custom_cnn), ('ResNet50', resnet_model)]:\n    visualize_gradcam(model, model_name, X_test, y_test)","metadata":{"_uuid":"a36a3181-9493-4e66-883d-d049e981ba25","_cell_guid":"ab59eed1-3bb1-4110-9ac3-33c7fbbebefa","trusted":true,"collapsed":false,"jupyter":{"outputs_hidden":false},"execution":{"iopub.status.busy":"2026-06-05T22:35:48.682703Z","iopub.execute_input":"2026-06-05T22:35:48.683062Z","iopub.status.idle":"2026-06-05T22:35:55.551175Z","shell.execute_reply.started":"2026-06-05T22:35:48.683034Z","shell.execute_reply":"2026-06-05T22:35:55.549947Z"}},"outputs":[{"name":"stdout","text":"  Grad-CAM layer: block4_conv2\n","output_type":"stream"},{"output_type":"display_data","data":{"text/plain":"<Figure size 2250x3675 with 21 Axes>","image/png":"\n"},"metadata":{}},{"name":"stdout","text":"Grad-CAM saved for Custom CNN\nGradCAM init failed for ResNet50: No such layer: conv5_block3_out. Existing layers are: ['input_resnet', 'scale255', 'resnet_preprocess', 'resnet50', 'gap_rn', 'dense_1', 'dropout_1', 'dense_2', 'dropout_2', 'out_rn'].\n","out