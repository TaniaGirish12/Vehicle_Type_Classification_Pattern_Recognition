ge, [crop_h, crop_w, 3])\n    image = tf.image.resize(image, IMG_SIZE)\n    image = tf.clip_by_value(image, 0.0, 1.0)\n    return image, label\n\n@tf.function\ndef load_and_preprocess(path, label, augment=False):\n    \"\"\"Load, resize, normalize image; optionally augment.\"\"\"\n    img = tf.io.read_file(path)\n    img = tf.image.decode_image(img, channels=3, expand_animations=False)\n    img = tf.cast(img, tf.float32)\n    img = tf.image.resize(img, IMG_SIZE) / 255.0\n    if augment:\n        img, label = augment_image(img, label)\n    return img, label\n\ndef build_dataset(paths, labels, batch_size, augment=False, shuffle=False, onehot=False):\n    \"\"\"Build tf.data.Dataset pipeline with optional augmentation and one-hot labels.\"\"\"\n    ds = tf.data.Dataset.from_tensor_slices(\n        (tf.constant(paths, dtype=tf.string), tf.constant(labels, dtype=tf.int32)))\n    if shuffle:\n        ds = ds.shuffle(len(paths), seed=SEED, reshuffle_each_iteration=True)\n    ds = ds.map(lambda p, l: load_and_preprocess(p, l, augment), num_parallel_calls=tf.data.AUTOTUNE)\n    if onehot:\n        ds = ds.map(lambda x, y: (x, tf.one_hot(y, CONFIG['num_classes'])))\n    return ds.batch(batch_size).prefetch(tf.data.AUTOTUNE)\n\n# Build pipelines\ntrain_ds     = build_dataset(X_train, y_train, CONFIG['batch_size'], augment=True,  shuffle=True)\nval_ds       = build_dataset(X_val,   y_val,   CONFIG['batch_size'])\ntest_ds      = build_dataset(X_test,  y_test,  CONFIG['batch_size'])\ntrain_ds_oh  = build_dataset(X_train, y_train, CONFIG['batch_size'], augment=True,  shuffle=True, onehot=True)\nval_ds_oh    = build_dataset(X_val,   y_val,   CONFIG['batch_size'], onehot=True)\ntest_ds_oh   = build_dataset(X_test,  y_test,  CONFIG['batch_size'], onehot=True)\nprint(\"tf.data pipelines ready.\")\n\n# ── Figure: Augmentation showcase ────────────────────────────────────────────\nsample_img = np.array(Image.open(random.choice(X_train)).convert('RGB').resize(IMG_SIZE)) / 255.0\nfig, axes = plt.subplots(2, 5, figsize=(20, 8))\nfig.suptitle('Data Augmentation Examples', fontsize=16, fontweight='bold')\naxes[0, 0].imshow(sample_img); axes[0, 0].set_title('Original', fontweight='bold'); axes[0, 0].axis('off')\naugs = [\n    ('H-Flip',    np.fliplr(sample_img)),\n    ('V-Flip',    np.flipud(sample_img)),\n    ('Brightness', np.clip(sample_img + 0.15, 0, 1)),\n    ('Contrast',   np.clip((sample_img - 0.5) * 1.3 + 0.5, 0, 1)),\n    ('Rotation',   np.rot90(sample_img)),\n    ('Zoom',       np.array(Image.fromarray((sample_img*255).astype(np.uint8)).crop((20,20,204,204)).resize(IMG_SIZE)) / 255.0),\n    ('Hue',        np.clip(sample_img * [1.1, 0.95, 0.9], 0, 1)),\n    ('Saturation', np.clip(sample_img * 0.7 + 0.15, 0, 1)),\n    ('Combined',   np.clip(np.fliplr(sample_img) * 1.2, 0, 1)),\n]\nfor i, (name, aug_img) in enumerate(augs):\n    r, c = (i+1)//5, (i+1)%5\n    axes[r, c].imshow(aug_img)\n    axes[r, c].set_title(name, fontweight='bold')\n    axes[r, c].axis('off')\nplt.tight_layout()\nplt.savefig(os.path.join(CONFIG['figures_dir'], 'fig4_augmentation.png'), dpi=150, bbox_inches='tight')\nplt.show()\nprint(\"Augmentation figure saved.\")","metadata":{"_uuid":"bcfe99a7-5f15-4f91-adc2-aa25ec5b8474","_cell_guid":"6a33e39f-e56d-422b-b5b1-1a26c460f5e2","trusted":true,"collapsed":false,"jupyter":{"outputs_hidden":false},"execution":{"iopub.status.busy":"2026-06-05T20:52:07.439973Z","iopub.execute_input":"2026-06-05T20:52:07.440271Z","iopub.status.idle":"2026-06-05T20:52:14.104818Z","shell.execute_reply.started":"2026-06-05T20:52:07.440248Z","shell.execute_reply":"2026-06-05T20:52:14.10348Z"}},"outputs":[{"name":"stderr","text":"I0000 00:00:1780692727.879685      58 gpu_device.cc:2019] Created device /job:localhost/replica:0/task:0/device:GPU:0 with 13757 MB memory:  -> device: 0, name: Tesla T4, pci bus id: 0000:00:04.0, compute capability: 7.5\nI0000 00:00:1780692727.882389      58 gpu_device.cc:2019] Created device /job:localhost/replica:0/task:0/device