es='tight')\nplt.show()\nprint(\"Error analysis complete.\")","metadata":{"_uuid":"ccafb891-3c13-4210-b72f-3afc40fcbd14","_cell_guid":"ac0db0ec-a21d-48ba-b607-b7eabad5ee2a","trusted":true,"collapsed":false,"jupyter":{"outputs_hidden":false},"execution":{"iopub.status.busy":"2026-06-05T22:36:12.665005Z","iopub.execute_input":"2026-06-05T22:36:12.665276Z","iopub.status.idle":"2026-06-05T22:36:17.181901Z","shell.execute_reply.started":"2026-06-05T22:36:12.665255Z","shell.execute_reply":"2026-06-05T22:36:17.180858Z"}},"outputs":[{"name":"stdout","text":"\nError Analysis — Best Model: EfficientNetB0 (Acc: 99.28%)\n\nPer-class error rates:\n  Class                 TP    FP    FN    Err%\n  Auto Rickshaws       117     0     3    2.5%\n  Bikes                120     0     0    0.0%\n  Cars                 118     2     1    2.5%\n  Motorcycles          118     1     2    2.5%\n  Planes               120     0     0    0.0%\n  Ships                120     1     0    0.8%\n  Trains               120     2     0    1.6%\n\nTop misclassification pairs:\n  Auto Rickshaws     → Trains                2 (1.7%)\n  Motorcycles        → Cars                  2 (1.7%)\n  Auto Rickshaws     → Motorcycles           1 (0.8%)\n  Cars               → Ships                 1 (0.8%)\n","output_type":"stream"},{"output_type":"display_data","data":{"text/plain":"<Figure size 2700x1050 with 2 Axes>","image/png":"\n"},"metadata":{}},{"name":"stdout","text":"\nTotal misclassified: 6 / 839 (0.7%)\n","output_type":"stream"},{"output_type":"display_data","data":{"text/plain":"<Figure size 3000x3000 with 16 Axes>","image/png":"\n"},"metadata":{}},{"name":"stdout","text":"Error analysis complete.\n","output_type":"stream"}],"execution_count":30},{"cell_type":"code","source":"# ===========================================================================\n# SECTION 16: PERFORMANCE COMPARISON\n# ===========================================================================\n\nprint(\"\\n\" + \"=\" * 70)\npri