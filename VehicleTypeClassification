f)\n            self.class_names = cfg['class_names']\n            self.img_size = tuple(cfg['img_size'])\n        else:\n            self.class_names = CLASS_NAMES\n            self.img_size = IMG_SIZE\n\n        self.n_classes = len(self.class_names)\n        layer = LAST_CONV_LAYERS.get(model_type, None)\n\n        try:\n            self.gcam = GradCAM(self.model, layer) if layer else None\n        except:\n            self.gcam = None\n\n        print(f\"Loaded: {self.model.name} | Classes: {self.class_names}\")\n\n    def _preprocess(self, image_path):\n        \"\"\"Load and normalize a single image to [0,1].\"\"\"\n        img = Image.open(image_path).convert('RGB').resize(self.img_size, Image.BILINEAR)\n        return np.array(img, dtype=np.float32)[np.newaxis] / 255.0\n\n    def predict(self, image_path, top_k=5, generate_gradcam=False):\n        \"\"\"\n        Predict vehicle class with confidence scores.\n\n        Returns dict with:\n          predicted_class, confidence, top_k (list), processing_time_ms,\n          gradcam_overlay (if requested)\n        \"\"\"\n        orig = np.array(Image.open(image_path).convert('RGB').resize(self.img_size))\n        batch = self._preprocess(image_path)\n\n        t0 = time.time()\n        proba = self.model.predict(batch, verbose=0)[0]\n        ms = (time.time() - t0) * 1000\n\n        top_idx = np.argsort(proba)[::-1][:top_k]\n        result = {\n            'predicted_class': self.class_names[top_idx[0]],\n            'predicted_index': int(top_idx[0]),\n            'confidence': float(proba[top_idx[0]]),\n            'confidence_pct': float(proba[top_idx[0]] * 100),\n            'top_k': [{'class': self.class_names[i], 'index': int(i),\n                        'probability': float(proba[i]),\n                        'percentage': float(proba[i] * 100)} for i in top_idx],\n            'all_probabilities': {cls: float(p) for cls, p in zip(self.class_names, proba)},\n            'processing_time_ms': ms,\n        }\n\n        if generate_gradcam and self.gcam:\n            try:\n                hm, _, _ = self.gcam.compute(batch)\n                ov, hm_c = self.gcam.overlay(hm, orig)\n                result['gradcam_heatmap'] = hm\n                result['gradcam_overlay'] = ov\n                result['gradcam_heatmap_colored'] = hm_c\n            except Exception as e:\n                print(f\"Grad-CAM failed: {e}\")\n\n        return result\n\n    def predict_batch(self, image_paths, batch_size=32):\n        \"\"\"Batch inference returning list of prediction dicts.\"\"\"\n        results = []\n        for i in range(0, len(image_paths), batch_size):\n            batch_paths = image_paths[i:i+batch_size]\n            imgs = []\n            for path in batch_paths:\n                try:\n                    imgs.append(self._preprocess(path)[0])\n                except:\n                    imgs.append(np.zeros((*self.img_size, 3), dtype=np.float32))\n            probas = self.model.predict(np.stack(imgs), verbose=0)\n            for path, proba in zip(batch_paths, probas):\n                top_idx = np.argmax(proba)\n                results.append({\n                    'image_path': path,\n                    'predicted_class': self.class_names[top_idx],\n                    'confidence': float(proba[top_idx]),\n                    'all_probabilities': {c: float(p) for c, p in zip(self.class_names, proba)},\n                })\n        return results\n\n    def visualize(self, image_path, save_path=None):\n        \"\"\"3-panel visualization: original | probabilities bar | Grad-CAM overlay.\"\"\"\n        result = self.predict(image_path, top_k=self.n_classes, generate_gradcam=True)\n        fig, axes = plt.subplots(1, 3, figsize=(18, 6))\n        fig.suptitle(\n            f'Prediction: {result[\"predicted_class\"].replace(\"_\",\" \").title()} '\n            f'({result[\"confidence_pct\"]:.1f}% confidence)',\n            fontsize=16, fontweight='bold'\n        )\n        img_orig = Image.open(image_path).convert('RGB').resize(self.img_size)\n        axes[0].imshow(img_orig); axes[0].set_title('Input Image', fontsize=13); axes[0].axis('off')\n\n        classes = [d['class'].replace('_','\\n') for d in result['top_k']]\n        probs   = [d['probability'] for d in result['top_k']]\n        bar_c = ['#F44336' if i == 0 else '#90CAF9' for i in range(len(probs))]\n        axes[1].barh(classes[::-1], probs[::-1], color=bar_c[::-1])\n        axes[1].set_title('Class Probabilities', fontsize=13)\n        axes[1].set_xlabel('Probability'); axes[1].set_xlim(0, 1); axes[1].grid(axis='x', alpha=0.3)\n        for bar_, prob in zip(axes[1].patches, probs[::-1]):\n            axes[1].text(prob + 0.01, bar_.get_y() + bar_.get_height()/2,\n                         f'{prob*100:.1f}%', va='center', fontsize=9)\n\n        if 'gradcam_overlay' in result:\n            axes[2].imshow(result['gradcam_overlay'])\n            axes[2].set_title('Grad-CAM Attention', fontsize=13)\n        else:\n            axes[2].text(0.5, 0.5, 'Grad-CAM\\nNot Available',\n                         ha='center', va='center', transform=axes[2].transAxes, fontsize=13)\n        axes[2].axis('off')\n        plt.tight_layout()\n        if save_path:\n            plt.savefig(save_path, dpi=150, bbox_inches='tight')\n        plt.show()\n        return result\n\n\n# ── Demo inference ────────────────────────────────────────────────────────────\nprint(\"\\nDemonstrating VehicleClassifier inference pipeline:\")\nprint(\"-\" * 60)\nbest_keras = os.path.join(CONFIG['model_dir'],\n    f\"{best_model_name.lower().replace(' ','_')}.keras\")\ncfg_path = os.path.join(CONFIG['model_dir'], 'model_config.json')\n\ntry:\n    clf = VehicleClassifier(best_keras, cfg_path, best_model_name.lower().replace(' ','_'))\n    for path in random.sample(list(X_test), 3):\n        res = clf.predict(path, top_k=3)\n        idx = list(X_test).index(path)\n        true_cls = CLASS_NAMES[y_test[idx]]\n        o